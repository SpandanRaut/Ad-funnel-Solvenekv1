# Public settings: never put secrets in NUXT_PUBLIC_* variables.
# Canonical origin, including https://. Falls back to Netlify URL, then localhost
# with a loud build warning. Set this to the public custom domain before publishing.
NUXT_PUBLIC_SITE_URL=
# Owner-supplied legal details. Missing values are omitted with build warnings.
NUXT_PUBLIC_CONTACT_EMAIL=support@solvenek.com
NUXT_PUBLIC_LEGAL_NAME=
NUXT_PUBLIC_BUSINESS_ADDRESS=
# YYYY-MM-DD; owner/counsel must approve this effective date.
NUXT_PUBLIC_LEGAL_EFFECTIVE_DATE=
# Optional analytics IDs. Empty disables that provider. GPC/DNT disable both.
# Production only; loaded after hydration and browser idle.
NUXT_PUBLIC_GA_ID=
NUXT_PUBLIC_META_PIXEL_ID=
# Local development console logging only: set to 1 to inspect sanitized events.
NUXT_PUBLIC_ANALYTICS_DEBUG=
# Existing Calendly booking URL.
NUXT_PUBLIC_CALENDLY_URL=https://calendly.com/bhurajxtha/30min
# Existing server-only legacy lead integration. Do not expose this to the browser.
LEAD_WEBHOOK_URL=
